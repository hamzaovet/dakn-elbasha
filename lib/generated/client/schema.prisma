datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

// ----------------------------------------------------
// 1. MULTI-BRANCH SYSTEM (منظومة الفروع المتعددة)
// ----------------------------------------------------
model Branch {
  id              String                   @id @default(cuid())
  name            String // e.g. "فرع حدائق القبة", "فرع مدينة نصر"
  code            String                   @unique // "BR-KOBBA", "BR-NASR-CITY"
  address         String
  phone           String
  whatsapp        String?
  googleMapsUrl   String?
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  users           User[]
  specialists     Specialist[]
  bookings        Booking[]
  tickets         Ticket[]
  products        Product[]
  ledgers         SpecialistLedger[]
  offers          Offer[]
  chatMessages    ChatMessage[]
  shifts          CashShift[]
  expenses        TreasuryExpense[]
  attendances     AttendanceRecord[]
  transfers       StockTransfer[]
  consumptionLogs MaterialConsumptionLog[]
}

// ----------------------------------------------------
// 2. STAFF & USERS RBAC (المستخدمين والصلاحيات)
// ----------------------------------------------------
model User {
  id                String             @id @default(cuid())
  name              String
  username          String             @unique // maestro, hadayek-mgr, nasr-mgr, cashier1, etc.
  passwordHash      String // 123456789
  pin               String             @default("157230") // PIN Code
  phone             String?
  role              String             @default("owner") // owner, general_manager, manager, cashier, specialist, worker
  branchId          String?
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  permissions       String? // JSON array
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  specialistProfile Specialist?
  attendances       AttendanceRecord[]
}

// ----------------------------------------------------
// 3. SPECIALISTS / BARBERS (المتخصصين وكراسي الحلاقة)
// ----------------------------------------------------
model Specialist {
  id           String  @id @default(cuid())
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId     String
  branch       Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  photo        String? // ImgBB URL
  title        String  @default("خبير حلاقة وتصفيف")
  chairNumber  Int     @default(1)
  status       String  @default("AVAILABLE") // AVAILABLE, WITH_CLIENT, BREAK, OFF_DUTY, DAY_OFF, ABSENT
  statusReason String? // سبب التعطيل أو الملاحظة (مثلاً: إجازة أسبوعية، استراحة غداء، انتهى اليوم ومشي)
  rating       Float   @default(4.9)

  // Compensation & Payroll scheme
  payType        String @default("SALARY_PLUS_COMMISSION") // DAILY, WEEKLY, MONTHLY, COMMISSION_ONLY, SALARY_PLUS_COMMISSION
  baseSalary     Float  @default(0)
  commissionRate Float  @default(20) // %

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  bookings Booking[]
  tickets  Ticket[]
  ledgers  SpecialistLedger[]
}

// ----------------------------------------------------
// 4. DYNAMIC SERVICES CATALOG (الخدمات التجميلية والحلاقة)
// ----------------------------------------------------
model Service {
  id              String   @id @default(cuid())
  nameAr          String
  nameEn          String?
  category        String   @default("HAIR") // HAIR, BEARD, SKIN_CARE, VIP_PACKAGES, KIDS, COLOR_KERATIN
  price           Float
  durationMinutes Int      @default(30)
  description     String?
  image           String? // ImgBB URL
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// ----------------------------------------------------
// 5. CUSTOMER DATABASE & CRM (قاعدة بيانات العملاء والتسويق)
// ----------------------------------------------------
model Customer {
  id               String    @id @default(cuid())
  name             String
  phone            String    @unique
  email            String?
  passwordHash     String?
  isVerified       Boolean   @default(false)
  verificationCode String?
  avatar           String?
  notes            String?
  vipLevel         String    @default("REGULAR") // REGULAR, VIP, GOLD_MEMBER
  totalVisits      Int       @default(0)
  totalSpent       Float     @default(0)
  createdAt        DateTime  @default(now())
  lastVisitAt      DateTime?

  bookings Booking[]
  tickets  Ticket[]
}

// ----------------------------------------------------
// 6. APPOINTMENTS & BOOKINGS (الحجوزات المسبقة)
// ----------------------------------------------------
model Booking {
  id                 String      @id @default(cuid())
  bookingNumber      String      @unique // SAD-XXXX
  customerId         String
  customer           Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  specialistId       String?
  specialist         Specialist? @relation(fields: [specialistId], references: [id], onDelete: SetNull)
  serviceIds         String // JSON array: [{ id, nameAr, price, durationMinutes }]
  bookingDate        String // YYYY-MM-DD
  timeSlot           String // e.g. "05:00 PM"
  status             String      @default("CONFIRMED") // PENDING, CONFIRMED, IN_CHAIR, COMPLETED, CANCELLED, NO_SHOW
  notes              String?
  totalAmount        Float       @default(0)
  reminderSentAt     DateTime?
  overdueAlertSentAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

// ----------------------------------------------------
// 7. IN-CHAIR LIVE TICKETS (شاشة المتخصص والكرسي اللحظية)
// ----------------------------------------------------
model Ticket {
  id            String     @id @default(cuid())
  ticketNumber  String     @unique // CHAIR-XXXX
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  specialistId  String
  specialist    Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  chairNumber   Int        @default(1)
  status        String     @default("IN_CHAIR") // IN_CHAIR, READY_FOR_CASHIER, COMPLETED, CANCELLED

  services    String @default("[]") // JSON: [{ id, nameAr, price, addedAt }]
  retailItems String @default("[]") // JSON: [{ id, nameAr, price, qty, total }]

  servicesTotal Float  @default(0)
  retailTotal   Float  @default(0)
  discount      Float  @default(0)
  tipAmount     Float  @default(0)
  finalAmount   Float  @default(0)
  paymentMethod String @default("CASH") // CASH, CARD, INSTAPAY, VODAFONE_CASH

  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationMinutes Int?

  cashierName String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------
// 8. RETAIL & CONSUMABLE BEAUTY PRODUCTS (بضاعة التجميل وخامات التشغيل والمخزن)
// ----------------------------------------------------
model Product {
  id                   String   @id @default(cuid())
  branchId             String?
  branch               Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  nameAr               String
  category             String   @default("STYLING") // STYLING, BEARD_CARE, SKIN_CARE, PERFUMES, ACCESSORIES, CONSUMABLES, LASER_SUPPLIES
  price                Float // سعر البيع للجمهور (إذا كان RETAIL) أو قيمة الخدمة
  costPrice            Float    @default(0) // تكلفة الشراء
  stockQty             Int      @default(50) // رصيد الفرع الحالي
  minStockAlert        Int      @default(10) // حد الطلب والتنبيه
  image                String? // ImgBB URL
  barcode              String? // باركود فريد دائم (سواء مولد تلقائي أو دولي)
  barcodeType          String   @default("AUTO") // AUTO (مولد تلقائي مميز DKN-XXXXXX), EXISTING (باركود المصنع)
  usageType            String   @default("RETAIL") // RETAIL (بضاعة بيع للعملاء), CONSUMABLE (خامات استهلاك وتشغيل)
  unit                 String   @default("PIECE") // PIECE (قطعة/شفرة/فوطة), BOTTLE (عبوة), GRAM (جرام), ML (مل), BOX (علبة)
  centralStockQty      Int      @default(0) // رصيد المخزن الرئيسي العام
  consumptionRule      String? // JSON rule: e.g. {"type":"PER_SERVICE","serviceCategory":"BEARD","qty":1}
  estimatedUsesPerUnit Int      @default(1) // عدد مرات الاستخدام الافتراضية لكل عبوة
  currentOpenedUnits   Int      @default(0) // عدد العبوات المفتوحة قيد الاستهلاك في محطات العمل
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  purchases       StockPurchase[]
  transfers       StockTransfer[]
  consumptionLogs MaterialConsumptionLog[]
}

// ----------------------------------------------------
// 9. SPECIALIST LEDGER & PAYROLL (سجل حسابات وسلف وأجور المتخصصين)
// ----------------------------------------------------
model SpecialistLedger {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type         String // SALARY_PAYOUT, COMMISSION_EARNED, ADVANCE_WITHDRAWAL, BONUS, DEDUCTION
  amount       Float
  notes        String?
  date         DateTime   @default(now())
  recordedBy   String     @default("المالك (Maestro)")
  createdAt    DateTime   @default(now())
}

// ----------------------------------------------------
// 10. SYSTEM GLOBAL SETTINGS & KILL SWITCH (إعدادات النظام والتحكم)
// ----------------------------------------------------
model SystemSettings {
  id               String  @id @default("default-settings")
  salonNameAr      String  @default("مجموعة صالونات وسبا الباشا VIP")
  salonNameEn      String  @default("EL BASHA LUXURY SALON & SPA")
  logoUrl          String  @default("/dakn-logo.jpg")
  systemLocked     Boolean @default(false)
  lockMessage      String  @default("النظام مغلق مؤقتاً لأعمال الصيانة والتحديث.")
  hadayekPhone     String  @default("01210103025")
  nasrCityPhone    String  @default("01556782015")
  hotline          String  @default("01210103025")
  whatsappNumber   String  @default("01210103025")
  facebookUrl      String  @default("https://www.facebook.com/DaknElbashaSalon")
  instagramUrl     String?
  defaultOpenHour  String  @default("11:00 AM")
  defaultCloseHour String  @default("01:00 AM")

  // Weekly Day Off & Booking Policies
  weeklyDayOff          String  @default("MONDAY") // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY, NONE
  isDayOffEnabled       Boolean @default(true)
  dayOffMessage         String  @default("عفواً، صالونات وسبا الباشا في عطلة أسبوعية يوم الإثنين - نتشرف بحجز موعدكم طوال باقي أيام الأسبوع ✂️")
  bookingSlotInterval   Int     @default(30) // in minutes
  reminderMinutesBefore Int     @default(15) // reminder 15 min before
  receiptFooterNotes    String  @default("شكراً لزيارتكم مجموعة صالونات وسبا الباشا VIP 👑 تجربة ملوكية استثنائية")

  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// 11. DYNAMIC ROYAL OFFERS & PACKAGES (العروض الملكية والباكدجات)
// ----------------------------------------------------
model Offer {
  id              String   @id @default(cuid())
  titleAr         String // e.g. "عرض العريس الملكي"
  badge           String? // "خصم 46%", "VIP", "لفترة محدودة"
  price           Float // 3500
  oldPrice        Float? // 4000
  discountPercent Int? // 15
  image           String // "/offers/offer-groom-3500.jpg"
  description     String?
  features        String   @default("[]") // JSON array of bullet points
  branchId        String? // null = متاح في كل الفروع
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ----------------------------------------------------
// 12. IN-APP LIVE CHAT (شات مباشر وتواصل فوري بين الصالون والعملاء)
// ----------------------------------------------------
model ChatMessage {
  id            String   @id @default(cuid())
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId    String?
  customerName  String   @default("عميل VIP")
  customerPhone String?
  bookingId     String?
  sender        String // "CUSTOMER" or "SALON"
  senderName    String   @default("خدمة عملاء مجموعة الباشا VIP")
  message       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ----------------------------------------------------
// 13. CASH SHIFTS & DRAWER CLOSING (إقفال الورديات وتسليم النقدية)
// ----------------------------------------------------
model CashShift {
  id          String    @id @default(cuid())
  shiftNumber String    @unique // SHIFT-XXXX
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashierName String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  status      String    @default("OPEN") // OPEN, CLOSED

  // Financial breakdown
  ticketsCount      Int   @default(0)
  servicesTotal     Float @default(0) // إجمالي الحلاقة
  retailTotal       Float @default(0) // إجمالي مبيعات المنتجات
  cashCollected     Float @default(0) // نقدية كاش مقبوضة
  visaCollected     Float @default(0) // فيزا وماستر
  instapayCollected Float @default(0) // انستاباي
  vodafoneCollected Float @default(0) // فودافون كاش

  advancesPayouts Float @default(0) // سلف ومستحقات خرجت نقداً
  expensesTotal   Float @default(0) // مصروفات ونثريات خرجت نقداً

  expectedCash Float @default(0) // النقدية الصافية المطلوبة بالدرج
  actualCash   Float @default(0) // النقدية الفعلية المسلمة
  difference   Float @default(0) // عجز أو زيادة (+/-)

  handedTo String  @default("المالك (Maestro)") // تم تسليم الفلوس لمين
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// 14. GENERAL TREASURY EXPENSES (مصروفات ونثريات الخزينة)
// ----------------------------------------------------
model TreasuryExpense {
  id            String   @id @default(cuid())
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category      String // SUPPLIES, UTILITIES, RENT, REFRESHMENTS, MAINTENANCE, OTHER
  amount        Float
  paymentMethod String   @default("CASH") // CASH, CARD, INSTAPAY, VODAFONE_CASH
  description   String
  recipientName String? // اسم المستلم / المورد
  recordedBy    String   @default("الكاشير")
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
}

// ----------------------------------------------------
// 15. DIGITAL ATTENDANCE & PUNCH (بصمة الحضور والانصراف الرقمية)
// ----------------------------------------------------
model AttendanceRecord {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  status       String    @default("PRESENT") // PRESENT, LATE, LEFT_EARLY, COMPLETED
  notes        String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ----------------------------------------------------
// 16. CENTRAL WAREHOUSE: PURCHASES & OPENING INVENTORY (المشتريات وجرد أول المدة)
// ----------------------------------------------------
model StockPurchase {
  id            String   @id @default(cuid())
  invoiceNumber String // e.g. "PUR-2026-001" or "OPEN-BAL-001"
  type          String   @default("PURCHASE") // "PURCHASE" (فاتورة شراء), "OPENING_BALANCE" (جرد رصيد أول المدة)
  supplierName  String? // اسم المورد أو الشركة
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int // الكمية المضافة
  costPrice     Float // سعر الشراء للوحدة
  totalCost     Float // الإجمالي
  destination   String   @default("CENTRAL") // "CENTRAL" (المخزن الرئيسي) أو معرف فرع محدد
  notes         String?
  recordedBy    String   @default("مسئول المخزن")
  createdAt     DateTime @default(now())
}

// ----------------------------------------------------
// 17. CENTRAL WAREHOUSE: TRANSFERS & DISPATCH (التحويلات وصرف الفروع)
// ----------------------------------------------------
model StockTransfer {
  id             String   @id @default(cuid())
  transferNumber String // e.g. "TRF-2026-001"
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromLocation   String   @default("المخزن الرئيسي")
  toBranchId     String
  toBranch       Branch   @relation(fields: [toBranchId], references: [id], onDelete: Cascade)
  quantity       Int // الكمية المحولة
  status         String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  receivedBy     String? // اسم مستلم الفرع (الكاشير أو المدير)
  dispatchedBy   String   @default("مسئول المخزن العام")
  notes          String?
  createdAt      DateTime @default(now())
}

// ----------------------------------------------------
// 18. CONSUMABLES DEPLETION LOG (سجل الاستهلاك الذكي للخامات)
// ----------------------------------------------------
model MaterialConsumptionLog {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ticketId         String? // معرف الفاتورة/التذكرة إن وجد
  specialistId     String? // معرف المتخصص/الحلاق إن وجد
  serviceName      String? // اسم الخدمة المرتبطة (مثل: حلاقة ذقن بالبخار)
  quantityConsumed Float // الكمية المستهلكة (مثلاً: 1 شفرة، أو 0.04 عبوة = 15 مل)
  unit             String   @default("PIECE") // PIECE, BOTTLE, ML, GRAM
  reason           String   @default("AUTO_SERVICE_RULE") // AUTO_SERVICE_RULE, MANUAL_STATION_HANDOVER, WASTAGE
  date             String // YYYY-MM-DD
  notes            String?
  createdAt        DateTime @default(now())
}
